# ClinResearch AI — Backend & Analytics Environment Configuration

# Server Ports & URLs
PORT=5000
PYTHON_ANALYTICS_URL=http://127.0.0.1:8001
PYTHON_ANALYTICS_TIMEOUT_MS=120000

# AI / LLM Configuration
# Replace with a fresh valid key. Placeholder values are intentionally treated as not configured.
OPENAI_API_KEY=YOUR_ROTATED_API_KEY_HERE
# For OpenAI, leave this unset or use https://api.openai.com/v1.
# For Gemini OpenAI-compatible API, use https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
ENABLE_MOCK_LLM=false

# Tesseract OCR Path (Windows Example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=clinical_research
# Development only: lets auth/register/login use backend/data/dev-users.json if PostgreSQL is offline.
ENABLE_LOCAL_AUTH_FALLBACK=true

# JWT Secret (SECURITY NOTICE: Replace this with a strong random 256-bit key in production)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION_3948271
