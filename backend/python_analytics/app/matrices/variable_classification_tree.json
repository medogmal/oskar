    {
      "id": "evidence_synthesis_extraction",
      "label": "Systematic review / meta-analysis extraction item",
      "studyType": ["systematic_review", "meta_analysis"],
      "role": "covariate",
      "requiresResearchQuestionLink": true,
      "requiresObjectiveLink": true,
      "requiresUnitWhenNumeric": true,
      "examples": ["effect_size", "standard_error", "risk_of_bias_domain", "included_study_design"]
